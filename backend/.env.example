# 복사해서 .env 로 만든 뒤 값을 채운다. .env 는 커밋 금지.
# Gemini API 키 (https://aistudio.google.com/apikey). 비워 두면 챗봇이 고정 문장으로 답한다
LLM_API_KEY=
# 1 이면 API 로 사진 인식을 못 쓸 때(한도·과부하) 이 컴퓨터에 로그인된 Gemini CLI 로 한 번 더 시도한다 (시연 노트북용, 배포에서는 켜지 않음)
VISION_CLI=
# 휴대폰에서 PC 주소로 열 때 그 frontend 주소 (쉼표로 여러 개). localhost:5173 은 늘 허용한다. 예: http://172.16.0.10:5173
CORS_ORIGINS=
# agy 면 사진 인식을 Gemini API 대신 이 컴퓨터에 로그인된 Antigravity CLI 로 한다 (팀 테스트용, 배포에서는 비운다. docs/specs/worksheets.md)
VISION_ENGINE=
# VISION_ENGINE=agy 일 때 모델. 비우면 gemini-4-argon-low (agy models 로 목록)
VISION_AGY_MODEL=
